rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // --- Helper Functions ---

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // NOTE: removed normalization helper due to limitations in rules language.
    // Legacy phone comparisons will use raw phone strings from tokens/profile.

    // Fetch the current user's phone from their profile document
    function getUserPhone() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('phone', '');
    }

    // Purchases owned by UID (new model) or normalized phone (legacy docs)
    function isPurchaseOwner(data) {
      let buyerId = data.get('buyerId', '');
      let buyerPhone = data.get('buyerPhone', '');
      let tokenPhone = request.auth.token.get('phone_number', null);
      let profilePhone = getUserPhone();

      return buyerId != ''
        ? buyerId == request.auth.uid
        : (buyerPhone != '' && (
            (tokenPhone != null && buyerPhone == tokenPhone) ||
            (profilePhone != '' && buyerPhone == profilePhone)
          ));
    }

    // Anonymous fallback for old phone-keyed purchases.
    function isAnonymousLegacyPurchase(data) {
      return data.get('buyerId', '') == '' && data.get('buyerPhone', '') != '';
    }

    function isCreatorId(userId) {
      return isAuthenticated() && userId == request.auth.uid;
    }

    function isLockedMessageCreator(messageId) {
      return isAuthenticated()
        && get(/databases/$(database)/documents/lockedMessages/$(messageId)).data.get('createdBy', '') == request.auth.uid;
    }

    function isLockedMessageCreatorAfter(messageId) {
      return isAuthenticated()
        && getAfter(/databases/$(database)/documents/lockedMessages/$(messageId)).data.get('createdBy', '') == request.auth.uid;
    }

    function hasUidPurchase(messageId) {
      return isAuthenticated()
        && exists(/databases/$(database)/documents/purchases/$(request.auth.uid + '_' + messageId));
    }

    function hasOnlyPublicLockedMessageFields(data) {
      return data.keys().hasOnly([
        'teaserText',
        'unlockPrice',
        'expireMessage',
        'expiryTime',
        'createdAt',
        'createdBy',
        'updatedAt',
        'isPublic',
        'uniqueCode',
        'purchasedCount',
        'creatorName',
        'creatorUsername',
        'creatorPhotoUrl',
        'previewImageUrl',
        'previewVideoUrl',
        'previewDocumentUrl'
      ]);
    }

    // Check if user is a participant in a room
    function isParticipant(data) {
      let uid = request.auth.uid;
      let tokenPhone = request.auth.token.get('phone_number', null);
      let profilePhone = getUserPhone();

      let uids = data.get('participantUids', []);
      let phones = data.get('participantPhones', []);

      return isAuthenticated() && (
        (uid in uids) || 
        (tokenPhone != null && tokenPhone in phones) || 
        (profilePhone != '' && profilePhone in phones)
      );
    }

    // --- Collection Rules ---

    match /users/{userId} {
      allow read: if isAuthenticated();
      allow write: if isOwner(userId);

      match /memberships/{roomId} {
        allow read: if isOwner(userId);
        allow write: if isAuthenticated(); 
      }

      match /withdrawals/{withdrawalId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId)
          && request.resource.data.get('uid', '') == request.auth.uid;
        allow update, delete: if false;
      }
    }

    match /chat_rooms/{roomId} {
      allow create: if isAuthenticated();
      allow read: if isAuthenticated() && (resource == null || isParticipant(resource.data));
      allow update, delete: if isAuthenticated() && isParticipant(resource.data);
      
      match /messages/{messageId} {
        allow read, write: if isAuthenticated(); 
      }
    }

    match /groups/{groupId} {
      allow create: if isAuthenticated();
      allow read: if isAuthenticated() && (resource == null || isParticipant(resource.data));
      allow update, delete: if isAuthenticated() && isParticipant(resource.data);

      match /messages/{messageId} {
        allow read, write: if isAuthenticated();
      }
      match /members/{memberId} {
        allow read, write: if isAuthenticated();
      }
    }

    match /channels/{channelId} {
      allow create: if isAuthenticated();
      allow read: if isAuthenticated() && (resource == null || isParticipant(resource.data));
      allow update, delete: if isAuthenticated() && isParticipant(resource.data);

      match /messages/{messageId} {
        allow read, write: if isAuthenticated();
      }
      match /members/{memberId} {
        allow read, write: if isAuthenticated();
      }
    }

    match /lockedMessages/{messageId} {
      allow read: if hasOnlyPublicLockedMessageFields(resource.data)
        || isCreatorId(resource.data.get('createdBy', ''))
        || hasUidPurchase(messageId);
      allow create: if isAuthenticated()
        && request.resource.data.get('createdBy', '') == request.auth.uid
        && hasOnlyPublicLockedMessageFields(request.resource.data);
      allow update: if isAuthenticated()
        && resource.data.get('createdBy', '') == request.auth.uid
        && request.resource.data.get('createdBy', '') == request.auth.uid
        && hasOnlyPublicLockedMessageFields(request.resource.data);
      allow delete: if isAuthenticated() && resource.data.get('createdBy', '') == request.auth.uid;
    }

    match /lockedMessageContent/{messageId} {
      allow get: if isLockedMessageCreator(messageId) || hasUidPurchase(messageId);
      allow list: if false;
      allow create, update: if isLockedMessageCreatorAfter(messageId);
      allow delete: if isLockedMessageCreator(messageId);
    }

    match /order-items/{orderItemId} {
      allow read: if request.auth != null
              && resource.data.buyerId == request.auth.uid;

        allow get: if (
          isAuthenticated() && isPurchaseOwner(resource.data)
        );
    }

    match /polls/{pollId} {
      allow read, create, update: if isAuthenticated();
    }

    match /purchases/{purchaseId} {
      // Reads: prefer buyerId ownership, support legacy phone-only purchase docs.
      allow get: if (
        isAuthenticated() && isPurchaseOwner(resource.data)
      ) || (
        !isAuthenticated() && isAnonymousLegacyPurchase(resource.data)
      );
      allow list: if isAuthenticated() && isPurchaseOwner(resource.data);
      // Purchases are finalized by backend functions (admin SDK), not client writes.
      allow create, update, delete: if false;
    }

    match /wallets/{userId} {
      allow read: if isOwner(userId);
      allow create, update, delete: if false;
    }

    match /wallet_transactions/{transactionId} {
      allow read: if isAuthenticated()
        && resource.data.get('userId', '') == request.auth.uid;
      allow create, update, delete: if false;
    }

    match /withdrawals/{withdrawalId} {
      allow read: if isAuthenticated()
        && resource.data.get('uid', '') == request.auth.uid;
      allow create: if isAuthenticated()
        && request.resource.data.get('uid', '') == request.auth.uid;
      allow update, delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
